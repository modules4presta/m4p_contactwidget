<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file original="module" source-language="en-US" target-language="pl-PL" datatype="plaintext">
    <body>
      <trans-unit id="4bd9ef088a14b5f6fd9ef86e6f33037f">
        <source>Need help?</source>
        <target>Potrzebujesz pomocy?</target>
      </trans-unit>
      <trans-unit id="b85a78b94687e6a461243ef91761f65d">
        <source>Call or write to us, or leave your number and we will call you back.</source>
        <target>Zadzwoń, napisz albo zostaw numer – oddzwonimy.</target>
      </trans-unit>
      <trans-unit id="c75dacd985f6bf6b522e1b94fda96f89">
        <source>Have a question? We are happy to help.</source>
        <target>Masz pytanie? Chętnie pomożemy.</target>
      </trans-unit>
      <trans-unit id="8e9d94503c4f11436603d80d02f40a07">
        <source>Your session has expired. Refresh the page and try again.</source>
        <target>Sesja wygasła. Odśwież stronę i spróbuj ponownie.</target>
      </trans-unit>
      <trans-unit id="3ed61eb8a02faa01c836855c8127be2d">
        <source>Thank you, we will contact you as soon as possible.</source>
        <target>Dziękujemy, odezwiemy się najszybciej, jak to możliwe.</target>
      </trans-unit>
      <trans-unit id="8f81bb8da0c0c4ceaace58460b965e65">
        <source>Your request has already been sent. Please wait a moment before sending another one.</source>
        <target>Zgłoszenie zostało już wysłane. Poczekaj chwilę przed wysłaniem kolejnego.</target>
      </trans-unit>
      <trans-unit id="777f9e90cf251ec077f633406368c632">
        <source>Invalid request.</source>
        <target>Nieprawidłowe żądanie.</target>
      </trans-unit>
      <trans-unit id="a92e6734a018624b519192bfcd136394">
        <source>Tick the consent to the processing of your data.</source>
        <target>Zaznacz zgodę na przetwarzanie danych.</target>
      </trans-unit>
      <trans-unit id="2b3e9729e125a5173fe20e1dc37d4271">
        <source>Enter a valid e-mail address.</source>
        <target>Podaj prawidłowy adres e-mail.</target>
      </trans-unit>
      <trans-unit id="dfada3cb254f01282dc35095ba6da024">
        <source>Enter a valid phone number.</source>
        <target>Podaj prawidłowy numer telefonu.</target>
      </trans-unit>
      <trans-unit id="8644ac105927b621fe3dddaf8ba20a44">
        <source>The request could not be saved. Please try again.</source>
        <target>Nie udało się zapisać zgłoszenia. Spróbuj ponownie.</target>
      </trans-unit>
      <trans-unit id="43c9a47002a5baca41771ca51bb3aac6">
        <source>Connection error. Please try again.</source>
        <target>Błąd połączenia. Spróbuj ponownie.</target>
      </trans-unit>
      <trans-unit id="d3d2e617335f08df83599665eef8a418">
        <source>Close</source>
        <target>Zamknij</target>
      </trans-unit>
      <trans-unit id="02d4482d332e1aef3437cd61c9bcc624">
        <source>Contact us</source>
        <target>Kontakt z nami</target>
      </trans-unit>
      <trans-unit id="bcc254b55c4a1babdf1dcb82c207506b">
        <source>Phone</source>
        <target>Telefon</target>
      </trans-unit>
      <trans-unit id="1e884e3078d9978e216a027ecd57fb34">
        <source>E-mail</source>
        <target>E-mail</target>
      </trans-unit>
      <trans-unit id="80a0c205cd57b22fca7f174253870300">
        <source>Opening hours</source>
        <target>Godziny pracy</target>
      </trans-unit>
      <trans-unit id="a6fb493e0d6afa32b3ca332ea78d9d1c">
        <source>We will call you back</source>
        <target>Oddzwonimy do Ciebie</target>
      </trans-unit>
      <trans-unit id="b9d159395d9b9dc3b638b7803399aca3">
        <source>How should we contact you?</source>
        <target>Jak mamy się z Tobą skontaktować?</target>
      </trans-unit>
      <trans-unit id="521daf39e372791baf8221f9ff0727e1">
        <source>Your phone number</source>
        <target>Twój numer telefonu</target>
      </trans-unit>
      <trans-unit id="fd928a16a39fcd6ed0c06ab084309228">
        <source>e.g. 600 100 200</source>
        <target>np. 600 100 200</target>
      </trans-unit>
      <trans-unit id="7df61a0962e018c22de96180a1eef6b6">
        <source>We will write back to you</source>
        <target>Odpiszemy do Ciebie</target>
      </trans-unit>
      <trans-unit id="bc82c84acc0c68f760ecd5bac0dddc7d">
        <source>Your e-mail address</source>
        <target>Twój adres e-mail</target>
      </trans-unit>
      <trans-unit id="b2217640fbc13f12d39a3292cc88ab21">
        <source>e.g. name@company.com</source>
        <target>np. jan@firma.pl</target>
      </trans-unit>
      <trans-unit id="25d021d9d39b195ff3dcab932ee59448">
        <source>I agree to the processing of my personal data in order to be contacted.</source>
        <target>Wyrażam zgodę na przetwarzanie moich danych osobowych w celu kontaktu zwrotnego.</target>
      </trans-unit>
      <trans-unit id="56c34c6410dd45c5cec44149ad0ce037">
        <source>Privacy policy</source>
        <target>Polityka prywatności</target>
      </trans-unit>
      <trans-unit id="76dff9cf9e73cd3db7c2e7b3b2a524f6">
        <source>Call me back</source>
        <target>Proszę o kontakt</target>
      </trans-unit>
    </body>
  </file>
