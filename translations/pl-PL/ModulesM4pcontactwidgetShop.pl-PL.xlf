        <source>Contact</source>
        <target>Kontakt</target>
      </trans-unit>
      <trans-unit id="3b9eb993ddab67000e3dd4fe08ba5d4d">
        <source>We call back during the opening hours of the desk.</source>
        <target>Oddzwonimy w godzinach pracy działu.</target>
      </trans-unit>
      <trans-unit id="09609ec751e4baf176dd72594af6f182">
        <source>We will call you back as soon as we open.</source>
        <target>Oddzwonimy, gdy tylko zaczniemy pracę.</target>
      </trans-unit>
      <trans-unit id="a6fb493e0d6afa32b3ca332ea78d9d1c">
